VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN water_tank_controller ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 50745 61465 ) ;
ROW ROW_0 unithd 5520 10880 N DO 86 BY 1 STEP 460 0 ;
ROW ROW_1 unithd 5520 13600 FS DO 86 BY 1 STEP 460 0 ;
ROW ROW_2 unithd 5520 16320 N DO 86 BY 1 STEP 460 0 ;
ROW ROW_3 unithd 5520 19040 FS DO 86 BY 1 STEP 460 0 ;
ROW ROW_4 unithd 5520 21760 N DO 86 BY 1 STEP 460 0 ;
ROW ROW_5 unithd 5520 24480 FS DO 86 BY 1 STEP 460 0 ;
ROW ROW_6 unithd 5520 27200 N DO 86 BY 1 STEP 460 0 ;
ROW ROW_7 unithd 5520 29920 FS DO 86 BY 1 STEP 460 0 ;
ROW ROW_8 unithd 5520 32640 N DO 86 BY 1 STEP 460 0 ;
ROW ROW_9 unithd 5520 35360 FS DO 86 BY 1 STEP 460 0 ;
ROW ROW_10 unithd 5520 38080 N DO 86 BY 1 STEP 460 0 ;
ROW ROW_11 unithd 5520 40800 FS DO 86 BY 1 STEP 460 0 ;
ROW ROW_12 unithd 5520 43520 N DO 86 BY 1 STEP 460 0 ;
ROW ROW_13 unithd 5520 46240 FS DO 86 BY 1 STEP 460 0 ;
TRACKS X 230 DO 110 STEP 460 LAYER li1 ;
TRACKS Y 170 DO 181 STEP 340 LAYER li1 ;
TRACKS X 170 DO 149 STEP 340 LAYER met1 ;
TRACKS Y 170 DO 181 STEP 340 LAYER met1 ;
TRACKS X 230 DO 110 STEP 460 LAYER met2 ;
TRACKS Y 230 DO 133 STEP 460 LAYER met2 ;
TRACKS X 340 DO 74 STEP 680 LAYER met3 ;
TRACKS Y 340 DO 90 STEP 680 LAYER met3 ;
TRACKS X 460 DO 55 STEP 920 LAYER met4 ;
TRACKS Y 460 DO 67 STEP 920 LAYER met4 ;
TRACKS X 1700 DO 15 STEP 3400 LAYER met5 ;
TRACKS Y 1700 DO 18 STEP 3400 LAYER met5 ;
COMPONENTS 14 ;
    - _09_ sky130_fd_sc_hd__a21oi_2 ;
    - _10_ sky130_fd_sc_hd__inv_2 ;
    - _11_ sky130_fd_sc_hd__inv_2 ;
    - _12_ sky130_fd_sc_hd__o21a_2 ;
    - _13_ sky130_fd_sc_hd__a21oi_2 ;
    - _14_ sky130_fd_sc_hd__nor2_2 ;
    - _15_ sky130_fd_sc_hd__a21oi_2 ;
    - _16_ sky130_fd_sc_hd__o21ai_2 ;
    - _17_ sky130_fd_sc_hd__o211a_2 ;
