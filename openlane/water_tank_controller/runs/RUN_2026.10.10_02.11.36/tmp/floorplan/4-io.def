    - _07_ ( _16_ A2 ) ( _15_ Y ) + USE SIGNAL ;
    - _08_ ( _19_ A ) ( _18_ X ) + USE SIGNAL ;
    - alarm ( PIN alarm ) ( _14_ A ) ( _10_ Y ) + USE SIGNAL ;
    - clk ( PIN clk ) ( _22_ CLK ) ( _21_ CLK ) ( _20_ CLK ) + USE SIGNAL ;
    - dry_run_fault ( PIN dry_run_fault ) ( _09_ B1 ) + USE SIGNAL ;
    - level_full ( PIN level_full ) ( _17_ C1 ) ( _11_ A ) ( _09_ A2 ) + USE SIGNAL ;
    - level_low ( PIN level_low ) ( _16_ A1 ) ( _12_ B1 ) ( _09_ A1 ) + USE SIGNAL ;
    - pump_en ( PIN pump_en ) ( _19_ X ) + USE SIGNAL ;
    - rst_n ( PIN rst_n ) ( _22_ RESET_B ) ( _21_ RESET_B ) ( _20_ SET_B ) + USE SIGNAL ;
    - state\[0\] ( _20_ Q ) ( _15_ B1 ) ( _12_ A2 ) + USE SIGNAL ;
    - state\[1\] ( _21_ Q ) ( _17_ A1 ) ( _15_ A2 ) ( _12_ A1 ) + USE SIGNAL ;
    - state\[2\] ( _22_ Q ) ( _18_ A ) ( _17_ A2 ) ( _13_ A2 ) + USE SIGNAL ;
END NETS
END DESIGN
