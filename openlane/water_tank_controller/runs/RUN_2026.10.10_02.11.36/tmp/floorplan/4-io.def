    - _21_ sky130_fd_sc_hd__dfrtp_2 ;
    - _22_ sky130_fd_sc_hd__dfrtp_2 ;
END COMPONENTS
PINS 7 ;
    - alarm + NET alarm + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met3 ( -2000 -300 ) ( 2000 300 )
        + PLACED ( 48745 44540 ) N ;
    - clk + NET clk + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -140 -2000 ) ( 140 2000 )
        + PLACED ( 29210 2000 ) N ;
    - dry_run_fault + NET dry_run_fault + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met3 ( -2000 -300 ) ( 2000 300 )
        + PLACED ( 2000 30940 ) N ;
    - level_full + NET level_full + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -140 -2000 ) ( 140 2000 )
        + PLACED ( 230 2000 ) N ;
    - level_low + NET level_low + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -140 -2000 ) ( 140 2000 )
        + PLACED ( 3450 59465 ) N ;
    - pump_en + NET pump_en + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -140 -2000 ) ( 140 2000 )
        + PLACED ( 35650 59465 ) N ;
    - rst_n + NET rst_n + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met3 ( -2000 -300 ) ( 2000 300 )
        + PLACED ( 48745 10540 ) N ;
END PINS
NETS 19 ;
    - _00_ ( _20_ D ) ( _16_ Y ) + USE SIGNAL ;
    - _01_ ( _21_ D ) ( _17_ X ) + USE SIGNAL ;
    - _02_ ( _22_ D ) ( _14_ Y ) + USE SIGNAL ;
    - _03_ ( _18_ B ) ( _17_ B1 ) ( _16_ B1 ) ( _10_ A ) ( _09_ Y ) + USE SIGNAL ;
    - _04_ ( _15_ A1 ) ( _13_ A1 ) ( _11_ Y ) + USE SIGNAL ;
